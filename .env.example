# SecScan sozlamalari — bu faylni `.env` ga nusxalang va kerak bo'lsa o'zgartiring.
#   Copy-Item .env.example .env

# --- Skaner image versiyalari ---
# Takrorlanuvchi natija uchun aniq versiyaga "pin" qilish tavsiya etiladi.
# Bu qiymatlar ham CLI, ham docker-compose.yml tomonidan ishlatiladi.
TRIVY_IMAGE=aquasec/trivy:latest
GITLEAKS_IMAGE=zricethezav/gitleaks:latest
SEMGREP_IMAGE=semgrep/semgrep:latest
GRYPE_IMAGE=anchore/grype:latest
OSV_IMAGE=ghcr.io/google/osv-scanner:latest
TRUFFLEHOG_IMAGE=trufflesecurity/trufflehog:latest
BANDIT_IMAGE=cytopia/bandit:latest
HADOLINT_IMAGE=hadolint/hadolint:latest-alpine
CHECKOV_IMAGE=bridgecrew/checkov:latest
DOCKLE_IMAGE=goodwithtech/dockle:latest
NUCLEI_IMAGE=projectdiscovery/nuclei:latest
KICS_IMAGE=checkmarx/kics:latest
KUBELINTER_IMAGE=stackrox/kube-linter:latest
GOSEC_IMAGE=securego/gosec:latest
TESTSSL_IMAGE=drwetter/testssl.sh:latest
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable

# --- Docker'da ishga tushirish ---
# Skanlanadigan host papkasi -> konteyner ichida /workspace ga ulanadi.
# Masalan loyihalaringiz papkasi; ichidagi har qanday loyihani
# /workspace/<kichik-papka> ko'rinishida skanlash mumkin.
# SCAN_DIR=D:\projects

# --- Skan sozlamalari ---
# Standart yoqiladigan toollar (vergul bilan). Bo'sh = hammasi.
# Mavjud: trivy,grype,osv,gitleaks,trufflehog,semgrep,bandit,gosec,hadolint,
#         checkov,kics,kubelinter,dockle,nuclei,testssl,zap
# SECSCAN_TOOLS=trivy,semgrep,gitleaks

# Semgrep ruleset: auto | p/ci | p/owasp-top-ten | p/security-audit | p/default
SECSCAN_SEMGREP_CONFIG=auto

# Skandan chiqarib tashlanadigan papkalar (vergul bilan). Bo'sh qoldirilsa,
# standart ro'yxat ishlatiladi (.venv, node_modules, .git, dist, build, ...).
# SECSCAN_EXCLUDE_DIRS=.venv,node_modules,.git,dist,build

# Bitta skanerga ajratilgan maksimal vaqt (sekund).
SECSCAN_TIMEOUT=900

# CI gate: shu daraja yoki undan yuqori topilsa, chiqish kodi != 0 bo'ladi.
# Qiymatlar: none | low | medium | high | critical
SECSCAN_FAIL_ON=none
